# Claude API key
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=            # only when routing through a proxy/gateway

ANTHROPIC_MODEL=claude-fable-5-2
TRIAGE_EFFORT=medium             # low | medium | high | xhigh | max
TRIAGE_MAX_TURNS=40
TRIAGE_MAX_TOOL_CALLS=150
TRIAGE_TOKEN_BUDGET=1000000      # all tokens (input incl. cache + output) per run
TRIAGE_FALLBACKS=on              # off = no server-side refusal fallback

# Optional: raises GitHub's rate limit and allows private repos (read-only use)
GITHUB_TOKEN=
